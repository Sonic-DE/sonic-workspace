msgctxt "@title:group"
msgid "Desktop"
msgstr "ໜ້າຈໍ"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "ຮູບແບບໜ້າຈໍທີ່ເລືອກໃຊ້ຄວາມໂປ່ງໃສຂອງມັນເອງ. ຮູບແບບໜ້າຈໍເຊັ່ນ Silver Light ແລະ Silver Dark ໃຊ້ການຕັ້ງຄ່າເຫຼົ່ານີ້."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "ໃຊ້ການຕັ້ງຄ່າເຫຼົ່ານີ້ແທນການຕັ້ງຄ່າຂອງຮູບແບບໜ້າຈໍ"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "ແຜງ:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "ໜ້າຕ່າງປັອບອັບ:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "ຄຳແນະນຳ:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "ວິດເຈັດໜ້າຈໍ:"

msgctxt "@title:group"
msgid "Menus"
msgstr "ເມນູ"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "ຮູບແບບແອັບພລິເຄຊັນທີ່ເລືອກແຕ້ມເມນູແບບທຶບ. ຮູບແບບແອັບພລິເຄຊັນ Silver ແລະ Breeze ໃຊ້ການຕັ້ງຄ່ານີ້."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "ເມນູ:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "ແຖບຫົວເລື່ອງ"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "ການຕົກແຕ່ງໜ້າຕ່າງທີ່ເລືອກແຕ້ມແຖບຫົວເລື່ອງແບບທຶບ. ການຕົກແຕ່ງໜ້າຕ່າງ Silver ໃຊ້ການຕັ້ງຄ່າເຫຼົ່ານີ້."

msgctxt "@label:slider"
msgid "Active window:"
msgstr "ໜ້າຕ່າງທີ່ໃຊ້ງານ:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "ໜ້າຕ່າງທີ່ບໍ່ໄດ້ໃຊ້ງານ:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "ເຮັດໃຫ້ແຖບຫົວເລື່ອງຂອງໜ້າຕ່າງທີ່ຂະຫຍາຍສູງສຸດທຶບສະເໝີ"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "ເຮັດໃຫ້ແຖບຫົວເລື່ອງທີ່ໂປ່ງໃສມົວ"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "ນຳໃຊ້ຄວາມທຶບນີ້ກັບພື້ນທີ່ສ່ວນຫົວທັງໝົດ (ແຖບເຄື່ອງມື ແລະ ແຖບເມນູ)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "ປັບແຖບຫົວເລື່ອງໃຫ້ເຂົ້າກັບສີຂອງແອັບພລິເຄຊັນ"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "ຂໍ້ຍົກເວັ້ນ…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "ໂປ່ງໃສ"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "ທຶບ"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "ຂໍ້ຍົກເວັ້ນຂອງແຖບຫົວເລື່ອງ"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "ແທນທີ່:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "ໃຊ້ຂໍ້ຍົກເວັ້ນນີ້"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "ຊື່ແອັບພລິເຄຊັນ ຫຼື ຄລາສໜ້າຕ່າງ (ນິພົດປົກກະຕິ)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "ຄ່າເລີ່ມຕົ້ນ"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "ລຶບຂໍ້ຍົກເວັ້ນ"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "ຄວາມທຶບຂອງໜ້າຕ່າງທີ່ໃຊ້ງານ:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "ຄວາມທຶບຂອງໜ້າຕ່າງທີ່ບໍ່ໄດ້ໃຊ້ງານ:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "ນຳໃຊ້ຄວາມທຶບນີ້ກັບພື້ນທີ່ສ່ວນຫົວທັງໝົດ"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "ຂໍ້ຍົກເວັ້ນປ່ຽນແປງສະເພາະການຕັ້ງຄ່າແຖບຫົວເລື່ອງ ສຳລັບແອັບພລິເຄຊັນທີ່ກົງກັນ."

msgctxt "@action:button"
msgid "Add Exception"
msgstr "ເພີ່ມຂໍ້ຍົກເວັ້ນ"
