msgctxt "@title:group"
msgid "Desktop"
msgstr "Área de trabalho"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "O estilo da área de trabalho selecionado usa sua própria transparência. Estilos como Silver Light e Silver Dark usam estas configurações."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "Usar estas configurações em vez das do estilo da área de trabalho"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "Painéis:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "Janelas pop-up:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "Dicas:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "Widgets da área de trabalho:"

msgctxt "@title:group"
msgid "Menus"
msgstr "Menus"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "O estilo de aplicativos selecionado desenha menus opacos. Os estilos de aplicativos Silver e Breeze usam esta configuração."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "Menus:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "Barras de título"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "A decoração de janelas selecionada desenha barras de título opacas. A decoração de janelas Silver usa estas configurações."

msgctxt "@label:slider"
msgid "Active window:"
msgstr "Janela ativa:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "Janela inativa:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "Sempre deixar opacas as barras de título das janelas maximizadas"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "Desfocar as barras de título transparentes"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "Aplicar esta opacidade a toda a área do cabeçalho (barras de ferramentas e de menus)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "Combinar a barra de título com a cor do aplicativo"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "Exceções…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "Transparente"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "Opaco"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "Exceções das barras de título"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "Substituir:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "Usar esta exceção"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "Nome do aplicativo ou classe da janela (expressão regular)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "Padrão"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "Remover exceção"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "Opacidade da janela ativa:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "Opacidade das janelas inativas:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "Aplicar esta opacidade a toda a área do cabeçalho"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "Uma exceção altera apenas as configurações das barras de título, para os aplicativos correspondentes."

msgctxt "@action:button"
msgid "Add Exception"
msgstr "Adicionar exceção"
