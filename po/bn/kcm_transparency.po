msgctxt "@title:group"
msgid "Desktop"
msgstr "ডেস্কটপ"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "নির্বাচিত ডেস্কটপ শৈলী নিজস্ব স্বচ্ছতা ব্যবহার করে। Silver Light ও Silver Dark-এর মতো ডেস্কটপ শৈলী এই সেটিংস ব্যবহার করে।"

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "ডেস্কটপ শৈলীর নিজস্ব সেটিংসের বদলে এই সেটিংস ব্যবহার করুন"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "প্যানেল:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "পপ-আপ:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "টুলটিপ:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "ডেস্কটপ উইজেট:"

msgctxt "@title:group"
msgid "Menus"
msgstr "মেনু"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "নির্বাচিত অ্যাপ্লিকেশন শৈলী অস্বচ্ছ মেনু আঁকে। Silver ও Breeze অ্যাপ্লিকেশন শৈলী এই সেটিং ব্যবহার করে।"

msgctxt "@label:slider"
msgid "Menus:"
msgstr "মেনু:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "শিরোনাম বার"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "নির্বাচিত উইন্ডো সজ্জা অস্বচ্ছ শিরোনাম বার আঁকে। Silver উইন্ডো সজ্জা এই সেটিংস ব্যবহার করে।"

msgctxt "@label:slider"
msgid "Active window:"
msgstr "সক্রিয় উইন্ডো:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "নিষ্ক্রিয় উইন্ডো:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "সর্বোচ্চ আকারের উইন্ডোর শিরোনাম বার সবসময় অস্বচ্ছ রাখুন"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "স্বচ্ছ শিরোনাম বার ঝাপসা করুন"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "এই অস্বচ্ছতা পুরো হেডার এলাকায় প্রয়োগ করুন (টুলবার ও মেনু বার)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "শিরোনাম বার অ্যাপ্লিকেশনের রঙের সাথে মেলান"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "ব্যতিক্রম…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "স্বচ্ছ"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "অস্বচ্ছ"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "শিরোনাম বারের ব্যতিক্রম"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "ওভাররাইড:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "এই ব্যতিক্রম ব্যবহার করুন"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "অ্যাপ্লিকেশনের নাম বা উইন্ডো শ্রেণি (রেগুলার এক্সপ্রেশন)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "ডিফল্ট"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "ব্যতিক্রম সরান"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "সক্রিয় উইন্ডোর অস্বচ্ছতা:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "নিষ্ক্রিয় উইন্ডোর অস্বচ্ছতা:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "এই অস্বচ্ছতা পুরো হেডার এলাকায় প্রয়োগ করুন"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "ব্যতিক্রম কেবল মিলে যাওয়া অ্যাপ্লিকেশনের জন্য শিরোনাম বারের সেটিংস বদলায়।"

msgctxt "@action:button"
msgid "Add Exception"
msgstr "ব্যতিক্রম যোগ করুন"
