msgctxt "@title:group"
msgid "Desktop"
msgstr "Bàn làm việc"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "Kiểu bàn làm việc đã chọn dùng độ trong suốt riêng. Các kiểu bàn làm việc như Silver Light và Silver Dark dùng các thiết lập này."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "Dùng các thiết lập này thay cho thiết lập của kiểu bàn làm việc"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "Bảng:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "Cửa sổ bật lên:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "Chú giải:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "Phụ kiện bàn làm việc:"

msgctxt "@title:group"
msgid "Menus"
msgstr "Trình đơn"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "Kiểu ứng dụng đã chọn vẽ trình đơn không trong suốt. Các kiểu ứng dụng Silver và Breeze dùng thiết lập này."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "Trình đơn:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "Thanh tiêu đề"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "Trang trí cửa sổ đã chọn vẽ thanh tiêu đề không trong suốt. Trang trí cửa sổ Silver dùng các thiết lập này."

msgctxt "@label:slider"
msgid "Active window:"
msgstr "Cửa sổ hoạt động:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "Cửa sổ không hoạt động:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "Luôn làm thanh tiêu đề của cửa sổ phóng to không trong suốt"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "Làm mờ thanh tiêu đề trong suốt"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "Áp dụng độ đục này cho toàn bộ vùng đầu (thanh công cụ và thanh trình đơn)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "Khớp thanh tiêu đề với màu của ứng dụng"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "Ngoại lệ…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "Trong suốt"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "Không trong suốt"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "Ngoại lệ thanh tiêu đề"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "Ghi đè:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "Dùng ngoại lệ này"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "Tên ứng dụng hoặc lớp cửa sổ (biểu thức chính quy)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "Mặc định"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "Xoá ngoại lệ"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "Độ đục cửa sổ hoạt động:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "Độ đục cửa sổ không hoạt động:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "Áp dụng độ đục này cho toàn bộ vùng đầu"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "Ngoại lệ chỉ thay đổi thiết lập thanh tiêu đề, cho các ứng dụng khớp với nó."

msgctxt "@action:button"
msgid "Add Exception"
msgstr "Thêm ngoại lệ"
