msgstr "Sempre far opac li barres de titul de maximisat fenestres"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "Confuser transparent barres de titul"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "Applicar ti opacitá al tot area del cap (barres de instrumentarium e barres de menú)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "Adaptar li barre de titul al color del application"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "Exceptiones…"

msgctxt "@label:slider end"
