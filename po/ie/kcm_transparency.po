msgctxt "@title:group"
msgid "Desktop"
msgstr "Pupitre"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "Li selectet stil de pupitre usa su propri transparentie. Stiles de pupitre quam Silver Light e Silver Dark usa ti parametres."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "Usar ti parametres vice los del stil de pupitre"

