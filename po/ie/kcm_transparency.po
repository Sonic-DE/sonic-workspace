msgid "Desktop widgets:"
msgstr "Widgets de pupitre:"

msgctxt "@title:group"
msgid "Menus"
msgstr "Menús"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "Li selectet stil de applicationes designa menús opac. Li stiles de applicationes Silver e Breeze usa ti parametre."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "Menús:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "Barres de titul"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "Li selectet decoration de fenestre designa barres de titul opac. Li decoration de fenestre Silver usa ti parametres."

