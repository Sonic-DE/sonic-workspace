msgctxt "@title:group"
msgid "Desktop"
msgstr "Pracoŭny stol"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "Vybrany styl pracoŭnaha stała vykarystoŭvaje ŭłasnuju prazrystasć. Hetyja nałady vykarystoŭvajuć styli pracoŭnaha stała, naprykład Silver Light i Silver Dark."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "Vykarystoŭvać hetyja nałady zamiest naład stylu pracoŭnaha stała"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "Paneli:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "Vypłyŭnyja vokny:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "Padkazki:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "Vidžety pracoŭnaha stała:"

msgctxt "@title:group"
msgid "Menus"
msgstr "Meniu"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "Vybrany styl prahram maluje nieprazrystyja meniu. Hetu naładu vykarystoŭvajuć styli prahram Silver i Breeze."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "Meniu:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "Zahałoŭki akon"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "Vybranaje azdablennie akon maluje nieprazrystyja zahałoŭki. Hetyja nałady vykarystoŭvaje azdablennie akon Silver."

msgctxt "@label:slider"
msgid "Active window:"
msgstr "Aktyŭnaje akno:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "Nieaktyŭnaje akno:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "Zaŭsiody rabić nieprazrystymi zahałoŭki razhornutych akon"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "Razmyvać prazrystyja zahałoŭki akon"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "Užyvać hetu nieprazrystasć da ŭsioj vierchniaj voblasci (paneli instrumientaŭ i radki meniu)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "Padbirać kolier zahałoŭka pad kolier prahramy"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "Vykliučenni…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "Prazrysty"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "Nieprazrysty"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "Vykliučenni dla zahałoŭkaŭ akon"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "Zamianić:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "Vykarystoŭvać heta vykliučennie"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "Nazva prahramy abo kłas akna (rehularny vyraz)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "Pradvyznačanaje"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "Vydalić vykliučennie"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "Nieprazrystasć aktyŭnaha akna:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "Nieprazrystasć nieaktyŭnych akon:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "Užyvać hetu nieprazrystasć da ŭsioj vierchniaj voblasci"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "Vykliučennie zmianiaje tolki nałady zahałoŭkaŭ akon dla adpaviednych prahram."

msgctxt "@action:button"
msgid "Add Exception"
msgstr "Dadać vykliučennie"
