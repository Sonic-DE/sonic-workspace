msgctxt "@title:group"
msgid "Desktop"
msgstr "Skrivebord"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "Den valgte skrivebordsstil bruger sin egen gennemsigtighed. Skrivebordsstile som Silver Light og Silver Dark bruger disse indstillinger."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "Brug disse indstillinger i stedet for skrivebordsstilens egne"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "Paneler:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "Pop-op-vinduer:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "Værktøjstips:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "Skrivebordswidgets:"

msgctxt "@title:group"
msgid "Menus"
msgstr "Menuer"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "Den valgte programstil tegner uigennemsigtige menuer. Programstilene Silver og Breeze bruger denne indstilling."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "Menuer:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "Titellinjer"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "Den valgte vinduesdekoration tegner uigennemsigtige titellinjer. Vinduesdekorationen Silver bruger disse indstillinger."

msgctxt "@label:slider"
msgid "Active window:"
msgstr "Aktivt vindue:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "Inaktivt vindue:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "Gør altid titellinjer i maksimerede vinduer uigennemsigtige"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "Slør gennemsigtige titellinjer"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "Anvend denne uigennemsigtighed på hele hovedområdet (værktøjslinjer og menulinjer)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "Tilpas titellinjen til programmets farve"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "Undtagelser…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "Gennemsigtig"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "Uigennemsigtig"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "Undtagelser for titellinjer"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "Tilsidesæt:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "Brug denne undtagelse"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "Programnavn eller vinduesklasse (regulært udtryk)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "Standard"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "Fjern undtagelse"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "Uigennemsigtighed for aktivt vindue:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "Uigennemsigtighed for inaktive vinduer:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "Anvend denne uigennemsigtighed på hele hovedområdet"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "En undtagelse ændrer kun titellinjens indstillinger, for de programmer den passer til."

msgctxt "@action:button"
msgid "Add Exception"
msgstr "Tilføj undtagelse"
