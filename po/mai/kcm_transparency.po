msgctxt "@title:group"
msgid "Desktop"
msgstr "डेस्कटॉप"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "चयनित डेस्कटॉप शैली अपन पारदर्शिता उपयोग करैत अछि। Silver Light आ Silver Dark सन डेस्कटॉप शैली एहि सेटिंगक उपयोग करैत अछि।"

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "डेस्कटॉप शैलीक अपन सेटिंगक बदला एहि सेटिंगक उपयोग करू"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "पटल:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "पॉप-अप:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "अओजार सुझाव:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "डेस्कटॉप विजेट:"

msgctxt "@title:group"
msgid "Menus"
msgstr "मेनू"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "चयनित अनुप्रयोग शैली अपारदर्शी मेनू बनबैत अछि। Silver आ Breeze अनुप्रयोग शैली एहि सेटिंगक उपयोग करैत अछि।"

msgctxt "@label:slider"
msgid "Menus:"
msgstr "मेनू:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "शीर्षक पट्टी"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "चयनित विंडो सजावट अपारदर्शी शीर्षक पट्टी बनबैत अछि। Silver विंडो सजावट एहि सेटिंगक उपयोग करैत अछि।"

msgctxt "@label:slider"
msgid "Active window:"
msgstr "सक्रिय विंडो:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "निष्क्रिय विंडो:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "अधिकतम कएल विंडोक शीर्षक पट्टी सदिखन अपारदर्शी राखू"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "पारदर्शी शीर्षक पट्टी धुँधला करू"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "ई अपारदर्शिता पूरा हेडर क्षेत्र पर लागू करू (अओजार पट्टी आ मेनू पट्टी)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "शीर्षक पट्टीकेँ अनुप्रयोगक रंगसँ मिलाउ"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "अपवाद…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "पारदर्शी"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "अपारदर्शी"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "शीर्षक पट्टी अपवाद"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "अधिलेखित करू:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "ई अपवाद उपयोग करू"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "अनुप्रयोगक नाम अथवा विंडो वर्ग (रेगुलर एक्सप्रेशन)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "पूर्वनिर्धारित"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "अपवाद हटाउ"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "सक्रिय विंडोक अपारदर्शिता:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "निष्क्रिय विंडोक अपारदर्शिता:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "ई अपारदर्शिता पूरा हेडर क्षेत्र पर लागू करू"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "अपवाद मेल खाइत अनुप्रयोगक लेल केवल शीर्षक पट्टीक सेटिंग बदलैत अछि।"

msgctxt "@action:button"
msgid "Add Exception"
msgstr "अपवाद जोड़ू"
