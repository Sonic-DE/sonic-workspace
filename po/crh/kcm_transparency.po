msgctxt "@title:group"
msgid "Desktop"
msgstr "Masaüstü"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "Saylanğan masaüstü uslûbı öz şeffaflığını qullana. Silver Light ve Silver Dark kibi masaüstü uslûpları bu ayarlarnı qullana."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "Masaüstü uslûbınıñ öz ayarları yerine bu ayarlarnı qullan"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "Paneller:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "Açılğan pencereler:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "Aletipuçları:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "Masaüstü aletçikleri:"

msgctxt "@title:group"
msgid "Menus"
msgstr "Menüler"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "Saylanğan uyğulama uslûbı şeffaf olmağan menüler sızdıra. Silver ve Breeze uyğulama uslûpları bu ayarnı qullana."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "Menüler:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "Serlevha çubuqları"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "Saylanğan pencere bezegi şeffaf olmağan serlevha çubuqları sızdıra. Silver pencere bezegi bu ayarlarnı qullana."

msgctxt "@label:slider"
msgid "Active window:"
msgstr "Faal pencere:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "Faal olmağan pencere:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "Azamiyleştirilgen pencerelerniñ serlevha çubuqlarını er vaqıt şeffaf olmağan yap"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "Şeffaf serlevha çubuqlarını bulanıqlaştır"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "Bu şeffafsızlıqnı bütün başlıq saasına tatbiq et (alet çubuqları ve menü çubuqları)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "Serlevha çubuğını uyğulamanıñ reñgine uyğunlaştır"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "İstisnalar…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "Şeffaf"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "Şeffaf olmağan"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "Serlevha Çubuğı İstisnaları"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "Üstünden keç:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "Bu istisnanı qullan"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "Uyğulama adı ya da pencere sınıfı (muntazam ifade)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "Ögbelgilengen"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "İstisnanı Çetleştir"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "Faal pencereniñ şeffafsızlığı:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "Faal olmağan pencerelerniñ şeffafsızlığı:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "Bu şeffafsızlıqnı bütün başlıq saasına tatbiq et"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "İstisna tek serlevha çubuğı ayarlarını, onıñnen uyğun kelgen uyğulamalar içün deñiştire."

msgctxt "@action:button"
msgid "Add Exception"
msgstr "İstisna Ekle"
