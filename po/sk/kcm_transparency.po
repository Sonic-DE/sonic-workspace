msgctxt "@title:group"
msgid "Desktop"
msgstr "Pracovná plocha"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "Vybraný štýl pracovnej plochy používa vlastnú priehľadnosť. Tieto nastavenia používajú štýly pracovnej plochy ako Silver Light a Silver Dark."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "Použiť tieto nastavenia namiesto nastavení štýlu pracovnej plochy"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "Panely:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "Vyskakovacie okná:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "Tipy:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "Widgety pracovnej plochy:"

msgctxt "@title:group"
msgid "Menus"
msgstr "Ponuky"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "Vybraný štýl aplikácií kreslí nepriehľadné ponuky. Toto nastavenie používajú štýly aplikácií Silver a Breeze."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "Ponuky:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "Titulkové pruhy"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "Vybraná dekorácia okien kreslí nepriehľadné titulkové pruhy. Tieto nastavenia používa dekorácia okien Silver."

msgctxt "@label:slider"
msgid "Active window:"
msgstr "Aktívne okno:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "Neaktívne okno:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "Titulkové pruhy maximalizovaných okien vždy nepriehľadné"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "Rozmazať priehľadné titulkové pruhy"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "Použiť túto nepriehľadnosť na celú oblasť hlavičky (panely nástrojov a ponúk)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "Prispôsobiť titulkový pruh farbe aplikácie"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "Výnimky…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "Priehľadné"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "Nepriehľadné"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "Výnimky titulkových pruhov"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "Prepísať:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "Použiť túto výnimku"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "Názov aplikácie alebo trieda okna (regulárny výraz)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "Predvolená"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "Odstrániť výnimku"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "Nepriehľadnosť aktívneho okna:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "Nepriehľadnosť neaktívnych okien:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "Použiť túto nepriehľadnosť na celú oblasť hlavičky"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "Výnimka mení len nastavenia titulkových pruhov, a to pre aplikácie, ktorým zodpovedá."

msgctxt "@action:button"
msgid "Add Exception"
msgstr "Pridať výnimku"
