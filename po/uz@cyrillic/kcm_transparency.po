msgctxt "@title:group"
msgid "Desktop"
msgstr "Иш столи"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "Танланган иш столи услуби ўз шаффофлигидан фойдаланади. Silver Light ва Silver Dark каби иш столи услублари бу мосламалардан фойдаланади."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "Иш столи услубининг мосламалари ўрнига буларни ишлатиш"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "Панеллар:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "Қалқиб чиқувчи ойналар:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "Маслаҳатлар:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "Иш столи виджетлари:"

msgctxt "@title:group"
msgid "Menus"
msgstr "Менюлар"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "Танланган дастур услуби хира менюлар чизади. Silver ва Breeze дастур услублари бу мосламадан фойдаланади."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "Менюлар:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "Сарлавҳа панеллари"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "Танланган ойна безаги хира сарлавҳа панелларини чизади. Silver ойна безаги бу мосламалардан фойдаланади."

msgctxt "@label:slider"
msgid "Active window:"
msgstr "Фаол ойна:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "Фаол бўлмаган ойна:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "Ёйилган ойналарнинг сарлавҳа панелларини доим хира қилиш"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "Шаффоф сарлавҳа панелларини хиралаштириш"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "Бу хираликни бутун сарлавҳа қисмига қўллаш (асбоблар панели ва меню панеллари)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "Сарлавҳа панелини дастур рангига мослаш"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "Истиснолар…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "Шаффоф"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "Хира"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "Сарлавҳа панели истиснолари"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "Алмаштириш:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "Бу истиснони ишлатиш"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "Дастур номи ёки ойна синфи (мунтазам ифода)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "Стандарт"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "Истиснони олиб ташлаш"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "Фаол ойна хиралиги:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "Фаол бўлмаган ойналар хиралиги:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "Бу хираликни бутун сарлавҳа қисмига қўллаш"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "Истисно фақат мос келадиган дастурлар учун сарлавҳа панели мосламаларини ўзгартиради."

msgctxt "@action:button"
msgid "Add Exception"
msgstr "Истисно қўшиш"
