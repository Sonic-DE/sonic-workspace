msgctxt "@title:group"
msgid "Desktop"
msgstr "Површ"

msgctxt "@info"
msgid "The selected desktop style uses its own transparency. Desktop styles such as Silver Light and Silver Dark use these settings."
msgstr "Изабрани стил површи користи сопствену провидност. Ове поставке користе стилови површи као што су Silver Light и Silver Dark."

msgctxt "@option:check"
msgid "Use these settings instead of the desktop style's own"
msgstr "Користи ове поставке уместо поставки стила површи"

msgctxt "@label:slider"
msgid "Panels:"
msgstr "Панели:"

msgctxt "@label:slider"
msgid "Pop-ups:"
msgstr "Искачући прозори:"

msgctxt "@label:slider"
msgid "Tooltips:"
msgstr "Облачићи:"

msgctxt "@label:slider"
msgid "Desktop widgets:"
msgstr "Виџети површи:"

msgctxt "@title:group"
msgid "Menus"
msgstr "Менији"

msgctxt "@info"
msgid "The selected application style draws opaque menus. The Silver and Breeze application styles use this setting."
msgstr "Изабрани стил програма црта непровидне меније. Ову поставку користе стилови програма Silver и Breeze."

msgctxt "@label:slider"
msgid "Menus:"
msgstr "Менији:"

msgctxt "@title:group"
msgid "Titlebars"
msgstr "Насловне траке"

msgctxt "@info"
msgid "The selected window decoration draws opaque titlebars. The Silver window decoration uses these settings."
msgstr "Изабрана декорација прозора црта непровидне насловне траке. Ове поставке користи декорација прозора Silver."

msgctxt "@label:slider"
msgid "Active window:"
msgstr "Активни прозор:"

msgctxt "@label:slider"
msgid "Inactive window:"
msgstr "Неактивни прозор:"

msgctxt "checkbox label"
msgid "Always make maximized titlebars opaque"
msgstr "Насловне траке максимизованих прозора увек непровидне"

msgctxt "checkbox label"
msgid "Blur titlebars that have transparency"
msgstr "Замути провидне насловне траке"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area (toolbars and menu bars)"
msgstr "Примени ову непровидност на целу област заглавља (траке алатки и траке менија)"

msgctxt "checkbox label"
msgid "Match the titlebar to the application colour"
msgstr "Усклади насловну траку са бојом програма"

msgctxt "@action:button"
msgid "Exceptions…"
msgstr "Изузеци…"

msgctxt "@label:slider end"
msgid "Transparent"
msgstr "Провидно"

msgctxt "@label percent sign after an opacity value"
msgid "%"
msgstr "%"

msgctxt "@label:slider end"
msgid "Opaque"
msgstr "Непровидно"

msgctxt "@title"
msgid "Titlebar Exceptions"
msgstr "Изузеци насловних трака"

msgctxt "@option:check override a setting"
msgid "Override:"
msgstr "Потисни:"

msgctxt "@info:tooltip"
msgid "Use this exception"
msgstr "Користи овај изузетак"

msgctxt "@info:placeholder"
msgid "Application name or window class (regular expression)"
msgstr "Име програма или класа прозора (регуларни израз)"

msgctxt "@label a built-in exception"
msgid "Default"
msgstr "Подразумевани"

msgctxt "@action:button"
msgid "Remove Exception"
msgstr "Уклони изузетак"

msgctxt "@option:check"
msgid "Active window opacity:"
msgstr "Непровидност активног прозора:"

msgctxt "@option:check"
msgid "Inactive window opacity:"
msgstr "Непровидност неактивних прозора:"

msgctxt "checkbox label"
msgid "Apply these opacity settings to the entire header area"
msgstr "Примени ову непровидност на целу област заглавља"

msgctxt "@info"
msgid "An exception changes only the titlebar settings, for the applications it matches."
msgstr "Изузетак мења само поставке насловних трака, за програме којима одговара."

msgctxt "@action:button"
msgid "Add Exception"
msgstr "Додај изузетак"
