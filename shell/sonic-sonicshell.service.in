[Unit]
Description=Sonic Shell
After=plasma-ksmserver.service plasma-kcminit.service
PartOf=graphical-session.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/sonicshell --no-respawn
Restart=on-failure
Type=dbus
BusName=org.sonicde.sonicshell
Slice=session.slice
TimeoutSec=40sec

[Install]
WantedBy=plasma-core.target
